# Togather Server Caddyfile - STAGING Environment
# staging.toronto.togather.foundation
#
# Blue-Green Deployment: Change the upstream address to switch traffic
# Reference: specs/001-deployment-infrastructure/spec.md FR-009

# Global options
{
	# Email for Let's Encrypt notifications
	email admin@togather.foundation
	
	# Enable admin API on localhost only (for management)
	admin localhost:2019
	
	# Log level
	log {
		level INFO
	}
}

# ==============================================================================
# STAGING - staging.toronto.togather.foundation
# ==============================================================================
# ACTIVE SLOT: Change between localhost:8081 (blue) and localhost:8082 (green)
# ==============================================================================

staging.toronto.togather.foundation {
	# ======================================================================
	# Probe hardening — 2026-10-03 (Hermes). Independently reviewed before apply.
	# ======================================================================
	# Why: the SPA fallback answers 200 + index.html for unknown paths, so a
	# scanner hunting for secrets reads every hit as a finding and escalates.
	# On 2026-10-02 one scanner IP sent 394 requests in ~2 seconds (/.env,
	# /.ssh/id_rsa, /@fs/app/.env, /.htpasswd, /ssl/server.key, ...) and 366 of
	# them got 200. Nothing leaked — the fallback serves HTML — but the signal
	# was wrong. Probe paths observed in the logs include the secret file at
	# any depth (/shop/.env, /static/app/.env) and under /ssl and /@fs.
	#
	# This is a PARTIAL mitigation, not a clean-up of the 200 signal: it covers
	# dot-prefixed segments, bundler source-disclosure prefixes, and paths
	# ending in a secret-bearing extension. Wordlist paths like /phpmyadmin or
	# /serverless.yaml still reach the app. The durable fix is app-level —
	# unknown non-SPA paths should 404 instead of returning index.html.
	#
	# Scope: response hygiene ONLY. This is not a crash fix and must not be
	# treated as one. The 34-hour outage on the same day was Caddy 2.11.6 bug
	# #8101 (panic while the reverse proxy was still reading a request body
	# after the handler had returned), fixed upstream in #8107 and shipped in
	# 2.11.7, which is what runs now; the systemd unit's Restart=on-failure
	# drop-in is the control that keeps a repeat from becoming an outage.
	#
	# Placement: Caddy evaluates directives in its built-in order, not in file
	# order — header runs first, then respond, then reverse_proxy. So these
	# 404s short-circuit the upstream and still carry the security headers
	# set further down. The @html_pages / @static_assets Cache-Control rules do
	# NOT apply to them (they key on response Content-Type or /admin/static/*).

	# 1) Dot-prefixed path SEGMENT at any depth — /.env, /.git/config,
	#    /static/.env, /shop/.env, /.ENV — plus the once-encoded /%2Eenv form.
	#    /.well-known* is carved out: ACME challenges, security.txt.
	@probe_dotfiles {
		path_regexp dotfile (?i)(^|/)(\.|%2e)[^/]+
		not path /.well-known*
	}
	respond @probe_dotfiles 404

	# 2) Bundler / dev-server source-disclosure prefixes, with a right boundary
	#    so near-misses like /@identity are left alone.
	@probe_tooling {
		path_regexp tooling (?i)^/@(fs|vite|id|react-refresh)(/|$)
	}
	respond @probe_tooling 404

	# 3) Secret-bearing file extensions anywhere in the path — catches
	#    /ssl/server.key and /config.env, which rule 1 misses because the
	#    segment does not begin with a dot. The list is evidence-based: no
	#    legitimate path in the retained staging logs uses any of these.
	#    Pre-compressed assets (.gz, .br) are deliberately excluded.
	@probe_secrets {
		path_regexp secrets (?i)\.(env|git|ssh|htpasswd|htaccess|pem|key|sql|bak|backup|old|swp|php)$
	}
	respond @probe_secrets 404

	# Deliberately NOT here: a rule rejecting POST bodies on page routes. It was
	# drafted, reviewed, and dropped, and it must not come back. It could not
	# have prevented the 2.11.6 crash: the trigger request carried a Next-Action
	# header, which that rule exempted by design, and it exempted /api/* and
	# /mcp* as well. Default-deny on write methods across a vhost also risks
	# silently breaking a legitimate route (admin UI, webhooks, no-JS form
	# posts). The crash control is the 2.11.7 upgrade plus the Restart drop-in.

	@metrics_block {
		path /metrics
		not remote_ip 127.0.0.1 ::1
	}
	respond @metrics_block "Forbidden" 403

	# Grafana monitoring proxy (admin-only access)
	# Grafana runs on localhost:3000, only accessible via this proxy
	# Grafana is configured with GF_SERVER_ROOT_URL including /grafana subpath
	# and GF_SERVER_SERVE_FROM_SUB_PATH=true to handle URL rewriting
	# SECURITY: Requires admin authentication via auth_token cookie
	handle /grafana* {
		# Matcher: Check for admin auth cookie in Cookie header
		@authenticated {
			header Cookie *auth_token*
		}
		
		# Route: Authenticated users get access to Grafana
		handle @authenticated {
			reverse_proxy localhost:3000 {
				# Health check (using Grafana API endpoint)
				health_uri /grafana/api/health
				health_interval 30s
				health_timeout 5s
				
				# Preserve original request info for Grafana
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
			}
		}
		
		# Route: Unauthenticated users get 401
		respond "Unauthorized: Admin access required" 401
	}

	# BLUE_GREEN_SLOT_START - Managed by deployment script (do not remove this marker)
	# Reverse proxy to active slot
	# Current: Blue slot (port 8081)
	# To switch to green: Change to localhost:8082

	# SSE streaming proxy — must come before the main reverse_proxy block.
	# Gzip compression and keepalive-off both break SSE:
	#   - gzip buffers the response before sending (incompatible with streaming)
	#   - keepalive off prevents Caddy from holding the upstream connection open
	# The deployment script updates all "reverse_proxy localhost:PORT" entries within
	# BLUE_GREEN_SLOT_START/END, so this block stays in sync with the active slot.
	handle /api/v1/admin/scraper/events {
		reverse_proxy localhost:8081 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down X-Togather-Slot "blue"
			transport http {
				keepalive 30s
				keepalive_idle_conns 2
			}
		}
	}

	# Reverse proxy to active slot
	reverse_proxy localhost:8081 {
		# Health check configuration
		health_uri /health
		health_interval 10s
		health_timeout 5s
		health_status 2xx
		
		# Preserve client information
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		
		# Add slot identifier for debugging
		# Update this when switching slots: "blue" or "green"
		header_down X-Togather-Slot "blue"
		
		# Disable keepalive to prevent stale connections during deployments
		# This ensures fresh connections to new containers immediately
		# without requiring Caddy reload. Minor performance trade-off
		# (TCP handshake overhead) for zero-downtime static file updates.
		transport http {
			keepalive off
		}
	}
	# BLUE_GREEN_SLOT_END - Managed by deployment script (do not remove this marker)
	
	# Compression — exclude SSE endpoint (gzip buffers output, breaking streaming)
	@compressible {
		not path /api/v1/admin/scraper/events
	}
	encode @compressible gzip
	
	# Access logging
	log {
		output file /var/log/caddy/staging.toronto.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
	
	# Cache control: Prevent browsers from caching HTML pages
	# HTML pages embed commit hashes for cache-busting; stale HTML = stale commit display
	# Static assets use ?v=<commit> query params for cache-busting, so they get long-lived caching
	@html_pages {
		not path /admin/static/* /api/*
		header Content-Type text/html*
	}
	header @html_pages Cache-Control "no-cache, no-store, must-revalidate"
	
	@static_assets path /admin/static/*
	header @static_assets Cache-Control "public, max-age=31536000, immutable"
	
	# Security headers (staging - relaxed for testing)
	header {
		# Remove server information
		-Server
		
		# Security headers
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Download-Options "noopen"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		
		# Content Security Policy
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self';"
	}
	
	# Client body size limit
	request_body {
		max_size 10MB
	}
}

# ==============================================================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================================================
#
# Blue-Green Traffic Switching:
# -----------------------------
# To switch traffic from blue to green:
# 1. Set the active upstream port (localhost:8081 <-> localhost:8082) and the
#    X-Togather-Slot value ("blue" <-> "green") inside the
#    BLUE_GREEN_SLOT_START / BLUE_GREEN_SLOT_END markers below.
#    deploy.sh does this automatically — do not edit by line number, the file
#    has moved on since this note was written.
# 2. Reload Caddy: sudo systemctl reload caddy
# 3. Verify: curl -I https://staging.toronto.togather.foundation/health | grep X-Togather-Slot
#
# Deploy this file:
# ----------------
# scp deploy/config/environments/Caddyfile.staging SERVER:/tmp/
# ssh SERVER 'sudo cp /tmp/Caddyfile.staging /etc/caddy/Caddyfile && sudo systemctl reload caddy'
#
# Prerequisites:
# -------------
# - DNS: staging.toronto.togather.foundation → server IP
# - Firewall: Ports 80 and 443 open
# - Caddy installed: sudo apt install caddy
# - Log directory: sudo mkdir -p /var/log/caddy && sudo chown caddy:caddy /var/log/caddy
# - Application running on port 8081 (blue) or 8082 (green)
#
